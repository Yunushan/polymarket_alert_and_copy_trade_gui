# Copy to /etc/market-sentinel/market-sentinel.env and keep mode 0600.
# The default systemd unit binds only to 127.0.0.1. Do not expose the app
# directly to the Internet; use the bundled Caddy example for TLS and access control.

# Required durable operational state. The bundled web unit fails startup if
# any of these paths is absent or changed. Keeping every store beneath the
# StateDirectory means ProtectSystem=strict permits writes and the bundled
# backup service captures the files from /var/lib/market-sentinel.
POLYMARKET_ANALYTICS_CACHE_PATH=/var/lib/market-sentinel/polymarket_analytics_cache.json
POLYMARKET_LIVE_VALIDATION_REPORTS_PATH=/var/lib/market-sentinel/polymarket_live_validation_reports.json
POLYMARKET_LIVE_VALIDATION_DECISIONS_PATH=/var/lib/market-sentinel/polymarket_live_validation_decisions.json
POLYMARKET_LIVE_VALIDATION_PROMOTION_PROPOSAL_SNAPSHOTS_PATH=/var/lib/market-sentinel/polymarket_live_validation_promotion_proposal_snapshots.json

# Optional for authenticated health checks or an explicitly remote API bind.
# Generate with: openssl rand -hex 32
MARKET_SENTINEL_API_TOKEN=

# Optional process-start assertions. In production, set these from the reviewed
# release commit and frontend fingerprint before restarting the service. A
# mismatch fails startup instead of serving an unexpected checkout or bundle.
# MARKET_SENTINEL_SOURCE_REVISION=0123456789abcdef0123456789abcdef01234567
# MARKET_SENTINEL_FRONTEND_SHA256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Required when the Caddy browser UI is exposed. Use the exact public HTTPS
# origin after replacing the hostname in deploy/caddy/Caddyfile.example. Multiple
# trusted origins can be comma-separated; wildcards and paths are not accepted.
# MARKET_SENTINEL_ALLOWED_ORIGINS=https://analytics.example.com

# Market credentials belong in this root-owned, mode-0600 file or a dedicated
# secret manager. Never place real values in data/config.json or source control.
# POLYMARKET_PRIVATE_KEY=
# POLY_API_KEY=
